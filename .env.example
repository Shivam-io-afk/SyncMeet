# ==============================================================================
# SyncMeet AI - Example Environment Configuration
# Copy this file to .env and configure your values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application Ports
# ------------------------------------------------------------------------------
PORT=5000
# Comma-separated browser origins allowed to call the API in production.
CORS_ORIGINS=http://localhost:3000
# Number of trusted reverse-proxy hops in front of Express (leave 0 if directly exposed).
TRUST_PROXY_HOPS=0
NODE_ENV=development
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=12
# Optional fixed app origin for shared meeting links (public URL or LAN URL).
VITE_PUBLIC_APP_URL=

# ------------------------------------------------------------------------------
# 2. Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret_before_deployment
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Optional cookie domain for deployments that share a parent domain.
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Add this exact URL as an Authorized redirect URI in Google Cloud Console.
# This is the OAuth callback; /api/auth/google only starts the sign-in flow.
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Add this origin as an Authorized JavaScript origin in Google Cloud Console.
GOOGLE_FRONTEND_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Google Gemini AI API Configuration
# This is optional. The app uses a local transcript-based fallback without it.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. MongoDB Atlas Cloud Database Configuration
# Optional. Cloud persistence and database-backed authentication require a working connection.
# Keep this server-side variable unprefixed with VITE_.
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 5. Redis / Upstash Cache Configuration (Phase 1)
# Optional for local dev (falls back to memory store when unset).
# Required in multi-instance and production deployments for presence, reconnection
# grace periods, and Socket.IO cluster pub/sub adapter.
# ------------------------------------------------------------------------------
REDIS_URL=redis://default:your_redis_password@your-redis-host:6379

# ------------------------------------------------------------------------------
# 6. Observability & Structured Logging (Phase 3)
# Log level for Pino logger: debug, info, warn, error, silent.
# Defaults to info in production, debug in development, silent in test.
# ------------------------------------------------------------------------------
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 7. Sentry Error Monitoring (Phase 3)
# Optional. Unset disables Sentry error reporting cleanly.
# ------------------------------------------------------------------------------
SENTRY_DSN=
VITE_SENTRY_DSN=

# ------------------------------------------------------------------------------
# 8. BullMQ Background Worker Queue (Phase 3)
# Concurrency for background AI notes, transcripts, and reminder emails.
# Falls back seamlessly to in-memory async processing when REDIS_URL is unset.
# ------------------------------------------------------------------------------
BULLMQ_CONCURRENCY=5

